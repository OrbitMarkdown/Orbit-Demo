---
import "../styles/global.css";
import nav from "../data/nav.json"; // editable in Orbit (data file)
import footerNav from "../data/footer.json"; // editable in Orbit (data file)

import type { ImageMetadata } from "astro";

const SITE_NAME = "Fernway Coffee";

interface Props {
  // The page's own title ("The menu"); the site name is added after it.
  title: string;
  // Its intro, used when the SEO group has no description.
  description: string;
  // The page's SEO group from its Markdown (search title, description, share
  // picture, hidden) — each part overrides the defaults above.
  seo?: { title?: string; description?: string; image?: ImageMetadata; hidden?: boolean };
  // "article" for journal posts, else "website".
  type?: "website" | "article";
  // Structured data (schema.org JSON-LD) for this page.
  schema?: object | object[];
}

const { title, description, seo = {}, type = "website", schema } = Astro.props;
const pageTitle = seo.title ?? title;
const fullTitle = pageTitle === SITE_NAME ? pageTitle : `${pageTitle} — ${SITE_NAME}`;
const summary = seo.description ?? description;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The share picture: the page's own, else one made from its title at build time.
const ogKey = Astro.url.pathname.replace(/^\/+|\/+$/g, "") || "index";
const image = new URL(seo.image?.src ?? `/og/${ogKey}.png`, Astro.site);
const jsonLd = schema && {
  "@context": "https://schema.org",
  "@graph": Array.isArray(schema) ? schema : [schema],
};

// Where the demo ribbon and footer credit point: Orbit's own site.
// Not orbitmd.com — an unrelated company.
const ORBIT_URL = "https://orbitmarkdown.com";
const AUTHOR_URL = "https://johnspurgin.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={summary} />
    <link rel="canonical" href={canonical} />
    {seo.hidden && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    {!seo.image && <meta property="og:image:width" content="1200" />}
    {!seo.image && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="demo-ribbon">
      <a
        class="demo-ribbon-bar"
        href={ORBIT_URL}
        target="_blank"
        rel="noopener"
        title="This is a demo site for Orbit MD — click to learn more"
      >
        <span class="ribbon-1">Demo site</span>
        <span class="ribbon-2">Orbit MD ↗</span>
      </a>
    </div>

    <header class="site-header">
      <a class="brand" href="/">
        <img src="/favicon.svg" alt="" />
        <span class="brand-name">Fernway Coffee</span>
      </a>
      <nav>
        {nav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <nav class="footer-nav">
          {footerNav.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
        <span>Fernway Coffee · 14 Larch Lane, Fernway</span>
        <span>Mon–Fri 7am–6pm · Sat 8am–4pm · Sun 9am–3pm</span>
        <span class="footer-credit">
          Content edited with{" "}
          <a href={ORBIT_URL} target="_blank" rel="noopener">
            Orbit MD
          </a>
          · by{" "}
          <a href={AUTHOR_URL} target="_blank" rel="noopener">
            John Spurgin
          </a>
        </span>
      </div>
    </footer>
  </body>
</html>
