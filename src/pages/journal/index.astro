---
import Base from "../../layouts/Base.astro";
import { getCollection, getEntry } from "astro:content";
import PostCard from "../../components/PostCard.astro";

const journal = await getEntry("pages", "journal");
if (!journal) throw new Error("Missing pages/journal content entry");

// Every post, newest first.
const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base title="Journal" description={journal.data.subheading} seo={journal.data.seo}>
  <section class="hero">
    <h1>{journal.data.heading}</h1>
    <p class="sub">{journal.data.subheading}</p>
  </section>
  <section class="section">
    <div class="grid">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</Base>
