---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import PostCard from "../../components/PostCard.astro";

// Every post, newest first.
const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base title="Journal — Fernway Coffee" description="Notes on beans, brewing and the café.">
  <section class="hero">
    <h1>The journal</h1>
    <p class="sub">
      Notes on what we're roasting, how we're brewing it, and what's new at the café.
    </p>
  </section>
  <section class="section">
    <div class="grid">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</Base>
