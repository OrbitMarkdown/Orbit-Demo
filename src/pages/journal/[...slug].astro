---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import Callout from "../../components/Callout.astro";
import Figure from "../../components/Figure.astro";

// A rest route ([...slug], not [slug]): a post's id keeps its folder
// ("guides/dialling-in-espresso"), and only a rest parameter can hold the "/".
// This is what makes Orbit's `newFolders: true` safe for this collection.
export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, excerpt, heroImage, category, date, author, tags, seo } = post.data;
const url = new URL(Astro.url.pathname, Astro.site).href;

// Structured data: the post as an article, and where it sits on the site.
const schema = [
  {
    "@type": "BlogPosting",
    headline: seo?.title ?? title,
    description: seo?.description ?? excerpt,
    datePublished: date.toISOString().slice(0, 10),
    author: { "@type": "Person", name: author },
    url,
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Journal",
        item: new URL("/journal", Astro.site).href,
      },
      { "@type": "ListItem", position: 2, name: title, item: url },
    ],
  },
];
const published = date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base title={title} description={excerpt} seo={seo} type="article" schema={schema}>
  <article class="article">
    {heroImage && <img class="article-hero" src={heroImage.src} alt="" />}
    <h1>{title}</h1>
    <p class="article-meta">
      {category} · {published} · {author}
    </p>
    <div class="article-body">
      <Content components={{ Callout, Figure }} />
    </div>
    {tags.length > 0 && (
      <div class="tag-row">
        {tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}
  </article>
</Base>
