---
import Base from "../layouts/Base.astro";
import { getEntry, getCollection, render } from "astro:content";
import PostCard from "../components/PostCard.astro";

const home = await getEntry("pages", "home");
if (!home) throw new Error("Missing pages/home content entry");
const { Content } = await render(home);

// Three posts for the home page: featured ones first, then the newest.
const newestFirst = (await getCollection("posts")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const featured = [...newestFirst]
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 3);
---

<Base title="Fernway Coffee" description={home.data.subheading}>
  <section class="hero">
    <h1>{home.data.heading}</h1>
    <p class="sub">{home.data.subheading}</p>
    {home.data.ctaLabel && (
      <a class="btn" href={home.data.ctaHref}>
        {home.data.ctaLabel}
      </a>
    )}
    <div class="hero-body">
      <Content />
    </div>
  </section>

  <section class="section">
    <h2>From the journal</h2>
    <div class="grid">
      {featured.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</Base>
