---
// A journal post as a card: its hero image, category, title and excerpt,
// linking to the post. Used on the home page and the journal page.
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
  // The title's heading level: h3 under a section heading (home), h2 straight
  // under the page's h1 (journal) — headings mustn't skip a level.
  heading?: "h2" | "h3";
}

const { post, heading: Heading = "h3" } = Astro.props;
const { heroImage, category, title, excerpt } = post.data;
---

<a class="card" href={`/journal/${post.id}`}>
  {heroImage && <img src={heroImage.src} alt="" />}
  <div class="card-body">
    <p class="card-kicker">{category}</p>
    <Heading class="card-title">{title}</Heading>
    <p>{excerpt}</p>
  </div>
</a>
